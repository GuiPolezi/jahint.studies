# Copie este arquivo para .env e preencha com os seus valores.
# NUNCA commite o .env — ele está no .gitignore.

# Porta em que a API vai rodar
PORT=3001

# Banco de dados (MariaDB/MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jahint_studies

# Segredo usado para assinar os tokens JWT.
# Gere um valor longo e aleatório, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio
# Validade do token (ex.: 7d, 12h)
JWT_EXPIRES=7d

# Origem permitida no CORS (URL do frontend)
CORS_ORIGIN=http://localhost:5173

# Pasta onde os arquivos enviados (avatares, anexos) serão gravados
UPLOAD_DIR=uploads
